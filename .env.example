# Image anchor and optional equirectangular panorama
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# MiniMax H3 video generation
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_MODEL=MiniMax-H3
MINIMAX_POLL_INTERVAL_SECONDS=10
MINIMAX_TASK_TIMEOUT_SECONDS=2400

# Local reconstruction tools
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
COLMAP_BIN=colmap
NS_PROCESS_DATA_BIN=ns-process-data
NS_TRAIN_BIN=ns-train
NS_EXPORT_BIN=ns-export
